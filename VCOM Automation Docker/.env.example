# ============================================================
# SCADA VCOM Automation — Docker Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value below (no empty fields in production)
#   3. Never commit .env to version control
# ============================================================


# ------------------------------------------------------------
# VCOM MeteoControl Credentials
# The Playwright scraper logs into VCOM with these.
# ------------------------------------------------------------
VCOM_USERNAME=
VCOM_PASSWORD=
VCOM_SYSTEM_URL=https://vcom.meteocontrol.com/vcom/evaluation/index/index/systemId/YOUR_SYSTEM_ID

# Inverter IDs (JSON array string — keep the quotes and brackets)
# Example: INVERTER_IDS_JSON=["Id2784833","Id2784832","Id2784831"]
INVERTER_IDS_JSON=["Id2784833","Id2784832","Id2784831","Id27848312","Id2784835","Id2784837","Id27848310","Id2784838","Id2784839","Id2784834","Id2784836","Id27848311","Id27848212","Id27848211","Id2784822","Id2784829","Id27848210","Id2784821","Id2784828","Id2784823","Id2784824","Id2784825","Id2784827","Id2784826","Id2784879","Id2784872","Id2784877","Id2784875","Id2784874","Id2784876","Id2784873","Id27848712","Id27848710","Id2784878","Id2784871","Id27848711"]


# ------------------------------------------------------------
# Dashboard HTTP Basic Auth
# Sets the username/password for the FastAPI dashboard at :8080
# ------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASS=CHANGE_ME_strong_password_here


# ------------------------------------------------------------
# Telegram Bot
# Create a bot via @BotFather and paste the token here.
# TELEGRAM_CHAT_ID     = group chat ID (starts with -100...)
# TELEGRAM_PERSONAL_ID = your personal Telegram user ID
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PERSONAL_ID=


# ------------------------------------------------------------
# Odoo ERP Integration
# Odoo runs in a separate container on the same Docker host.
# host.docker.internal resolves to the host's Docker gateway.
# ------------------------------------------------------------
ODOO_URL=http://host.docker.internal:8069
ODOO_DB=odoo
ODOO_USER=
ODOO_PASS=


# ------------------------------------------------------------
# Ngrok Remote Tunnel (optional)
# Leave empty to disable. When set, the dashboard is reachable
# externally via an ngrok HTTPS URL.
# ------------------------------------------------------------
NGROK_AUTH_TOKEN=


# ------------------------------------------------------------
# Playwright / Extraction
# VCOM_HEADLESS=true  → headless Chromium (required in Docker)
# VCOM_HEADLESS=false → visible browser (only for local debug)
# ------------------------------------------------------------
VCOM_HEADLESS=true


# ------------------------------------------------------------
# Timezone
# Sets TZ for all containers. Default: Europe/Rome (Sicily).
# ------------------------------------------------------------
TZ=Europe/Rome
