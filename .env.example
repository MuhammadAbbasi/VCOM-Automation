# ============================================================================
# VCOM AUTOMATION SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT COMMIT .env TO VERSION CONTROL - it contains sensitive data!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual credentials
#   docker-compose up -d
#
# ============================================================================

# ============================================================================
# DOCKER COMPOSE & CONTAINER SETTINGS
# ============================================================================
DASHBOARD_PORT=8080
VCOM_HEADLESS=false

# Resource limits (adjust based on your system)
CONTAINER_CPU_LIMIT=4
CONTAINER_MEMORY_LIMIT=4G
CONTAINER_CPU_RESERVE=2
CONTAINER_MEMORY_RESERVE=2G

# Host paths for volume mounts
EXTRACTED_DATA_HOST_PATH=./extracted_data
LOGS_HOST_PATH=./logs
DATABASE_HOST_PATH=./db
ERRORS_HOST_PATH=./errors
ARTIFACTS_HOST_PATH=./artifacts

# ============================================================================
# VCOM SYSTEM CREDENTIALS
# ============================================================================
# Your MeteoControl VCOM system credentials
# Required for: vcom_monitor.py, processor_watchdog_final.py

VCOM_USERNAME=MarcelloPhoton
VCOM_PASSWORD=your_vcom_password_here
VCOM_SYSTEM_URL=https://vcom.meteocontrol.com/vcom/evaluation/index/index/systemId/2144635
NGROK_AUTH_TOKEN=your_ngrok_token_here

# ============================================================================
# DASHBOARD CREDENTIALS
# ============================================================================
# Web dashboard login credentials (for /app/dashboard/app.py)

DASHBOARD_USER=mazaraAdmin
DASHBOARD_PASS=your_dashboard_password_here

# ============================================================================
# LLM AGENT CONFIGURATION
# ============================================================================
# Configure which LLM service to use. Supports:
#   - Local: Ollama (recommended for privacy)
#   - Cloud: OpenAI, Anthropic
#
# For Ollama (local, privacy-first):
#   Install Ollama: https://ollama.ai
#   Run: ollama serve
#   Endpoint: http://localhost:11434/api/generate
#
# For OpenAI:
#   Get API key: https://platform.openai.com/api-keys
#
# For Anthropic:
#   Get API key: https://console.anthropic.com

# Local Ollama (Privacy-First)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
# Alternative models: mistral, neural-chat, dolphin-phi, qwen (slower but better quality)

# OpenAI (Cloud - requires paid API key)
OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic Claude (Cloud - requires paid API key)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# LLM Debug Mode (set to true to see prompt templates & API calls)
LLM_DEBUG_MODE=false

# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
# Optional: Send alerts via Telegram bot
# Create bot: https://t.me/BotFather
# Get chat ID: Send message to bot, then call: https://api.telegram.org/bot{TOKEN}/getUpdates

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# ODOO/TICKET SYSTEM CONFIGURATION
# ============================================================================
# Optional: Integrate with Odoo for automated ticket creation
# Required by: odoo_ticket_engine.py

ODOO_URL=https://your_odoo_instance.com
ODOO_DATABASE=your_database_name
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password
ODOO_API_KEY=your_odoo_api_key

# ============================================================================
# SYSTEM SETTINGS
# ============================================================================
# Timezone for logs and timestamped data
TZ=UTC

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# NOTES & SECURITY BEST PRACTICES
# ============================================================================
# 1. Keep this file secure - it contains sensitive credentials
# 2. Use strong passwords for all services
# 3. For production:
#    - Use a secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
#    - Use IAM roles instead of embedding API keys
#    - Rotate credentials regularly
#    - Enable audit logging
# 4. For local development:
#    - Use a local Ollama instance instead of cloud LLM APIs
#    - Limit API key permissions to minimum required scope
# 5. If a credential is compromised:
#    - Immediately rotate/revoke the compromised credential
#    - Audit logs to see what was accessed
#    - Update the .env file with new credential
# ============================================================================
